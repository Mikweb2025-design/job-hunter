# --- Dashboard-Login (HTTP Basic Auth) – auf einem Server unbedingt setzen ---
DASHBOARD_USER=daniele
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# --- Zeitplan (Cron, Zeitzone Europe/Berlin). Überschreibt config.yaml schedule.cron ---
# RUN_CRON=30 6 * * *

# --- LLM (optional; ohne Key arbeitet die App mit Regel-Score + Vorlage) ---
# KI-Anschreiben mit der opencode-CLI (config.yaml: llm.provider opencode). Im Docker-Image nur
# mit INSTALL_OPENCODE=1 (Build-Arg, wird von docker compose aus dieser Datei gelesen):
# INSTALL_OPENCODE=1
# LLM_PROVIDER=opencode
# LLM_MODEL=opencode/big-pickle    # kostenlos, läuft remote – keine lokale CPU-Last
# OPENCODE_BIN=/usr/local/bin/opencode   # sonst `opencode` im PATH bzw. ~/.opencode/bin/opencode
# LLM_TIMEOUT_S=180

# LLM_PROVIDER=anthropic          # none | anthropic | openai | opencode
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# OpenAI-kompatibel (IONOS AI Model Hub, Ollama, ...):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
# OPENAI_API_KEY=
# LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# Ollama auf dem Host: OPENAI_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3.2:3b
# ACHTUNG: der Server hat nur CPU – mit Ollama NUR kleine Modelle (z.B. llama3.2:3b) und
# OLLAMA_NUM_PARALLEL=1 / OLLAMA_MAX_LOADED_MODELS=1 setzen. Keine großen lokalen Modelle.

# --- Adzuna (optional, kostenlos: https://developer.adzuna.com/) ---
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- Telegram (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# PUBLIC_URL=https://jobs.example.org   # für Links in Telegram-Nachrichten

# UI_LANG=de        # de | it
# LOG_LEVEL=INFO

# --- Reverse Proxy in einem Unterordner (z.B. https://mikweb.eu/jobs/) ---
# BASE_PATH=/jobs
# JOBHUNTER_PORT=8000          # Host-Port (nur 127.0.0.1), freien Port wählen
